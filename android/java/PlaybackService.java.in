package @SLOPTUBE_APP_ID@;

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.pm.ServiceInfo;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.graphics.drawable.Icon;
import android.media.AudioAttributes;
import android.media.AudioFocusRequest;
import android.media.AudioManager;
import android.media.MediaMetadata;
import android.media.session.MediaSession;
import android.media.session.PlaybackState;
import android.os.Handler;
import android.os.IBinder;
import android.os.Looper;
import android.os.SystemClock;

import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;

// Keeps playback alive while the app is in the background (a media foreground service), and
// publishes it through a MediaSession: the media notification, the lock screen, headset buttons,
// Bluetooth devices and the picture-in-picture window's controls. Commands go to native code.
public final class PlaybackService extends Service {
    // The commands of nativeMediaCommand; MediaCommand in src/app/platform/Bridge.hpp.
    private static final int COMMAND_PLAY = 0;
    private static final int COMMAND_PAUSE = 1;
    private static final int COMMAND_NEXT = 2;
    private static final int COMMAND_PREVIOUS = 3;
    private static final int COMMAND_SEEK = 4;
    private static final int COMMAND_STOP = 5;

    private static final String CHANNEL = "playback";
    private static final int NOTIFICATION_ID = 1;
    private static final String ACTION_PLAY = "play";
    private static final String ACTION_PAUSE = "pause";
    private static final String ACTION_NEXT = "next";
    private static final String ACTION_PREVIOUS = "previous";
    private static final String ACTION_STOP = "stop";
    private static final String THUMBNAIL_URL = "https://i.ytimg.com/vi/%s/hqdefault.jpg";
    private static final int THUMBNAIL_TIMEOUT_MS = 10_000;

    // What native code last reported. Touched on the main thread only.
    static final class State {
        String videoId;
        String title;
        String channel;
        long durationMs;
        long positionMs;
        boolean playing;
        boolean buffering;
        float speed;
        boolean hasPrevious;
        boolean hasNext;
    }

    private static State state;
    private static PlaybackService instance;

    private MediaSession session;
    private AudioManager audio;
    private AudioFocusRequest focusRequest;
    private boolean hasFocus;
    private boolean resumeOnFocusGain;
    private String artworkVideoId;
    private Bitmap artwork;
    private final Handler main = new Handler(Looper.getMainLooper());

    private final BroadcastReceiver noisy = new BroadcastReceiver() {
        @Override
        public void onReceive(Context context, Intent intent) {
            // Headphones unplugged: the sound must not move to the speaker.
            nativeMediaCommand(COMMAND_PAUSE, 0);
        }
    };

    private static native void nativeMediaCommand(int command, long positionMs);

    static void update(Context context, State next) {
        state = next;
        if (instance != null) {
            instance.refresh();
            return;
        }
        try {
            context.startForegroundService(new Intent(context, PlaybackService.class));
        } catch (IllegalStateException | SecurityException refused) {
            // Android 12+ refuses to start it from the background: playback goes on without the
            // notification until the app is opened again.
        }
    }

    static void stop(Context context) {
        state = null;
        if (instance != null) {
            instance.stopForeground(STOP_FOREGROUND_REMOVE);
            instance.stopSelf();
        }
    }

    @Override
    public void onCreate() {
        super.onCreate();
        instance = this;
        audio = getSystemService(AudioManager.class);
        getSystemService(NotificationManager.class).createNotificationChannel(
                new NotificationChannel(CHANNEL, "Playback", NotificationManager.IMPORTANCE_LOW));

        session = new MediaSession(this, "SlopTube");
        session.setCallback(new MediaSession.Callback() {
            @Override
            public void onPlay() {
                nativeMediaCommand(COMMAND_PLAY, 0);
            }

            @Override
            public void onPause() {
                nativeMediaCommand(COMMAND_PAUSE, 0);
            }

            @Override
            public void onSkipToNext() {
                nativeMediaCommand(COMMAND_NEXT, 0);
            }

            @Override
            public void onSkipToPrevious() {
                nativeMediaCommand(COMMAND_PREVIOUS, 0);
            }

            @Override
            public void onSeekTo(long positionMs) {
                nativeMediaCommand(COMMAND_SEEK, positionMs);
            }

            @Override
            public void onStop() {
                nativeMediaCommand(COMMAND_STOP, 0);
            }
        });
        session.setSessionActivity(PendingIntent.getActivity(this, 0,
                new Intent(this, SlopTubeActivity.class), PendingIntent.FLAG_IMMUTABLE));
        session.setActive(true);

        focusRequest = new AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)
                .setAudioAttributes(new AudioAttributes.Builder()
                                .setUsage(AudioAttributes.USAGE_MEDIA)
                                .setContentType(AudioAttributes.CONTENT_TYPE_MOVIE)
                                .build())
                .setOnAudioFocusChangeListener(this::onFocusChange)
                .build();
        registerReceiver(noisy, new IntentFilter(AudioManager.ACTION_AUDIO_BECOMING_NOISY));
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        String action = intent != null ? intent.getAction() : null;
        if (ACTION_PLAY.equals(action)) {
            nativeMediaCommand(COMMAND_PLAY, 0);
        } else if (ACTION_PAUSE.equals(action)) {
            nativeMediaCommand(COMMAND_PAUSE, 0);
        } else if (ACTION_NEXT.equals(action)) {
            nativeMediaCommand(COMMAND_NEXT, 0);
        } else if (ACTION_PREVIOUS.equals(action)) {
            nativeMediaCommand(COMMAND_PREVIOUS, 0);
        } else if (ACTION_STOP.equals(action)) {
            nativeMediaCommand(COMMAND_STOP, 0);
        }
        refresh();
        return START_NOT_STICKY;
    }

    @Override
    public void onTaskRemoved(Intent rootIntent) {
        // The app was swiped away: playback goes with it.
        stop(this);
    }

    @Override
    public void onDestroy() {
        instance = null;
        unregisterReceiver(noisy);
        abandonFocus();
        session.setActive(false);
        session.release();
        super.onDestroy();
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }

    private void refresh() {
        State current = state;
        if (current == null) {
            // Started for a video closed since: the system still requires the notification.
            goForeground(new State());
            stop(this);
            return;
        }
        if (!current.videoId.equals(artworkVideoId)) {
            artworkVideoId = current.videoId;
            artwork = null;
            loadArtwork(current.videoId);
        }

        MediaMetadata.Builder metadata = new MediaMetadata.Builder()
                .putString(MediaMetadata.METADATA_KEY_TITLE, current.title)
                .putString(MediaMetadata.METADATA_KEY_ARTIST, current.channel)
                .putString(MediaMetadata.METADATA_KEY_MEDIA_ID, current.videoId);
        if (current.durationMs > 0) {
            metadata.putLong(MediaMetadata.METADATA_KEY_DURATION, current.durationMs);
        }
        if (artwork != null) {
            metadata.putBitmap(MediaMetadata.METADATA_KEY_ART, artwork);
        }
        session.setMetadata(metadata.build());

        long actions = PlaybackState.ACTION_PLAY | PlaybackState.ACTION_PAUSE
                | PlaybackState.ACTION_PLAY_PAUSE | PlaybackState.ACTION_STOP;
        if (current.durationMs > 0) {
            actions |= PlaybackState.ACTION_SEEK_TO;
        }
        if (current.hasNext) {
            actions |= PlaybackState.ACTION_SKIP_TO_NEXT;
        }
        if (current.hasPrevious) {
            actions |= PlaybackState.ACTION_SKIP_TO_PREVIOUS;
        }
        int playback = current.buffering ? PlaybackState.STATE_BUFFERING
                : current.playing ? PlaybackState.STATE_PLAYING : PlaybackState.STATE_PAUSED;
        session.setPlaybackState(new PlaybackState.Builder()
                        .setActions(actions)
                        .setState(playback, current.positionMs,
                                current.playing ? current.speed : 0,
                                SystemClock.elapsedRealtime())
                        .build());

        if (current.playing) {
            requestFocus();
        }
        goForeground(current);
    }

    private void goForeground(State current) {
        try {
            startForeground(NOTIFICATION_ID, notification(current),
                    ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK);
        } catch (IllegalStateException | SecurityException refused) {
            // Refused in the background (Android 12+): the session still answers its controls.
        }
    }

    private Notification notification(State current) {
        int icon = getResources().getIdentifier("ic_launcher_monochrome", "drawable",
                getPackageName());
        Notification.Builder builder = new Notification.Builder(this, CHANNEL)
                .setSmallIcon(icon)
                .setContentTitle(current.title)
                .setContentText(current.channel)
                .setLargeIcon(artwork)
                .setContentIntent(session.getController().getSessionActivity())
                .setDeleteIntent(action(ACTION_STOP))
                .setVisibility(Notification.VISIBILITY_PUBLIC)
                .setOnlyAlertOnce(true)
                .setShowWhen(false);
        int compact = 0;
        int[] shown = new int[3];
        if (current.hasPrevious) {
            builder.addAction(button(android.R.drawable.ic_media_previous, "Previous",
                    ACTION_PREVIOUS));
            shown[compact++] = 0;
        }
        builder.addAction(current.playing
                        ? button(android.R.drawable.ic_media_pause, "Pause", ACTION_PAUSE)
                        : button(android.R.drawable.ic_media_play, "Play", ACTION_PLAY));
        shown[compact] = compact;
        compact++;
        if (current.hasNext) {
            builder.addAction(button(android.R.drawable.ic_media_next, "Next", ACTION_NEXT));
            shown[compact] = compact;
            compact++;
        }
        int[] compactActions = new int[compact];
        System.arraycopy(shown, 0, compactActions, 0, compact);
        builder.setStyle(new Notification.MediaStyle()
                        .setMediaSession(session.getSessionToken())
                        .setShowActionsInCompactView(compactActions));
        return builder.build();
    }

    private Notification.Action button(int icon, String title, String action) {
        return new Notification.Action.Builder(Icon.createWithResource(this, icon), title,
                       action(action))
                .build();
    }

    private PendingIntent action(String action) {
        return PendingIntent.getService(this, action.hashCode(),
                new Intent(this, PlaybackService.class).setAction(action),
                PendingIntent.FLAG_IMMUTABLE);
    }

    private void loadArtwork(final String videoId) {
        new Thread(() -> {
            Bitmap bitmap = null;
            try {
                HttpURLConnection connection = (HttpURLConnection) new URL(
                        String.format(THUMBNAIL_URL, videoId)).openConnection();
                connection.setConnectTimeout(THUMBNAIL_TIMEOUT_MS);
                connection.setReadTimeout(THUMBNAIL_TIMEOUT_MS);
                try (InputStream in = connection.getInputStream()) {
                    bitmap = BitmapFactory.decodeStream(in);
                } finally {
                    connection.disconnect();
                }
            } catch (Exception failed) {
                return; // The notification keeps going without a picture.
            }
            final Bitmap loaded = bitmap;
            main.post(() -> {
                if (instance == this && videoId.equals(artworkVideoId) && loaded != null) {
                    artwork = loaded;
                    if (state != null) {
                        refresh();
                    }
                }
            });
        }).start();
    }

    private void requestFocus() {
        if (!hasFocus) {
            hasFocus = audio.requestAudioFocus(focusRequest)
                    == AudioManager.AUDIOFOCUS_REQUEST_GRANTED;
        }
    }

    private void abandonFocus() {
        if (hasFocus) {
            audio.abandonAudioFocusRequest(focusRequest);
            hasFocus = false;
        }
    }

    private void onFocusChange(int change) {
        switch (change) {
            case AudioManager.AUDIOFOCUS_LOSS:
                // Another app plays: stop for good, as the official app.
                hasFocus = false;
                resumeOnFocusGain = false;
                nativeMediaCommand(COMMAND_PAUSE, 0);
                break;
            case AudioManager.AUDIOFOCUS_LOSS_TRANSIENT:
                // A call or a navigation prompt: resume after it.
                resumeOnFocusGain = state != null && state.playing;
                nativeMediaCommand(COMMAND_PAUSE, 0);
                break;
            case AudioManager.AUDIOFOCUS_GAIN:
                if (resumeOnFocusGain) {
                    nativeMediaCommand(COMMAND_PLAY, 0);
                }
                resumeOnFocusGain = false;
                break;
            default:
                break; // Ducking is left to the system.
        }
    }
}

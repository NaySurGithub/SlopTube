// Generated by CMake from android/java/UploadsJob.java.in; edit the template.
package @SLOPTUBE_APP_ID@;

import android.Manifest;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.job.JobInfo;
import android.app.job.JobParameters;
import android.app.job.JobScheduler;
import android.app.job.JobService;
import android.content.ComponentName;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.os.Build;

import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.util.Locale;

// Checks the subscriptions feed for new uploads about once an hour, while notifications are on,
// and notifies each one; a tap opens it in the app. The check itself is native
// (src/app/notifications/Uploads.cpp).
public final class UploadsJob extends JobService {
    private static final int JOB_ID = 1;
    private static final long PERIOD_MS = 60 * 60 * 1000L;
    private static final String CHANNEL = "uploads";
    private static final String THUMBNAIL_URL = "https://i.ytimg.com/vi/%s/mqdefault.jpg";
    private static final int THUMBNAIL_TIMEOUT_MS = 10_000;
    // nativeNewUploads returns this many strings per video: id, title, channel.
    private static final int FIELDS = 3;

    static {
        System.loadLibrary("@SLOPTUBE_LIB_NAME@");
    }

    private static native String[] nativeNewUploads(String dataDirectory, String language,
            String region);

    static void schedule(Context context, boolean enabled) {
        JobScheduler scheduler = context.getSystemService(JobScheduler.class);
        if (!enabled) {
            scheduler.cancel(JOB_ID);
            return;
        }
        if (scheduler.getPendingJob(JOB_ID) != null) {
            return;
        }
        scheduler.schedule(new JobInfo.Builder(JOB_ID, new ComponentName(context, UploadsJob.class))
                        .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
                        .setPeriodic(PERIOD_MS)
                        .setPersisted(true)
                        .build());
    }

    @Override
    public boolean onStartJob(final JobParameters parameters) {
        new Thread(() -> {
            try {
                check();
            } catch (RuntimeException failed) {
                // Notifications are a convenience: a failed check waits for the next one.
            } finally {
                jobFinished(parameters, false);
            }
        }).start();
        return true;
    }

    @Override
    public boolean onStopJob(JobParameters parameters) {
        return true; // Try again later.
    }

    private void check() {
        Locale locale = Locale.getDefault();
        String[] found = nativeNewUploads(getFilesDir().getAbsolutePath(), locale.getLanguage(),
                locale.getCountry());
        if (found == null || found.length == 0) {
            return;
        }
        if (Build.VERSION.SDK_INT >= 33
                && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)
                        != PackageManager.PERMISSION_GRANTED) {
            return;
        }
        NotificationManager manager = getSystemService(NotificationManager.class);
        manager.createNotificationChannel(new NotificationChannel(CHANNEL, "New uploads",
                NotificationManager.IMPORTANCE_DEFAULT));
        int icon = getResources().getIdentifier("ic_launcher_monochrome", "drawable",
                getPackageName());
        for (int i = 0; i + FIELDS <= found.length; i += FIELDS) {
            String videoId = found[i];
            Intent open = new Intent(this, SlopTubeActivity.class)
                    .putExtra(SlopTubeActivity.EXTRA_VIDEO_ID, videoId)
                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            Notification notification = new Notification.Builder(this, CHANNEL)
                    .setSmallIcon(icon)
                    .setContentTitle(found[i + 2])
                    .setContentText(found[i + 1])
                    .setLargeIcon(thumbnail(videoId))
                    .setContentIntent(PendingIntent.getActivity(this, videoId.hashCode(), open,
                            PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT))
                    .setAutoCancel(true)
                    .build();
            manager.notify(videoId.hashCode(), notification);
        }
    }

    private static Bitmap thumbnail(String videoId) {
        try {
            HttpURLConnection connection = (HttpURLConnection) new URL(
                    String.format(THUMBNAIL_URL, videoId)).openConnection();
            connection.setConnectTimeout(THUMBNAIL_TIMEOUT_MS);
            connection.setReadTimeout(THUMBNAIL_TIMEOUT_MS);
            try (InputStream in = connection.getInputStream()) {
                return BitmapFactory.decodeStream(in);
            } finally {
                connection.disconnect();
            }
        } catch (Exception failed) {
            return null; // Notified without a picture.
        }
    }
}

        ArrayList<String> heard = data.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS);
        if (heard != null && !heard.isEmpty() && heard.get(0) != null) {
            nativeVoiceSearch(heard.get(0));
        }
    }


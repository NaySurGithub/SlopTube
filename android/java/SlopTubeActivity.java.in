        state.videoId = videoId;
        state.title = title;
        state.channel = channel;
        state.durationMs = durationMs;
        state.positionMs = positionMs;
        state.playing = playing;
        state.buffering = buffering;
        state.speed = speed;
        state.hasPrevious = hasPrevious;
        state.hasNext = hasNext;
        runOnUiThread(() -> {
            try {
                PlaybackService.update(this, state);
            } catch (RuntimeException failed) {
                // The notification is lost, not playback.
            }
        });
    }

    // No video is open any more.
    public void stopPlayback() {
        runOnUiThread(() -> {
            try {
                PlaybackService.stop(this);
            } catch (RuntimeException failed) {
                // Already gone.
            }
        });
    }

    // --- Updates ------------------------------------------------------------------------------

    // Installs the downloaded APK at `path` over this app. Android shows its confirmation (and,
    // the first time, asks to allow installing from SlopTube); the app restarts updated.
    public void installUpdate(final String path) {
        new Thread(() -> {
            try {
                PackageInstaller installer = getPackageManager().getPackageInstaller();
                PackageInstaller.SessionParams params = new PackageInstaller.SessionParams(
                        PackageInstaller.SessionParams.MODE_FULL_INSTALL);
                params.setAppPackageName(getPackageName());
                int id = installer.createSession(params);
                try (PackageInstaller.Session session = installer.openSession(id)) {
                    try (InputStream in = new FileInputStream(path);
                            OutputStream out = session.openWrite("update.apk", 0, -1)) {
                        byte[] buffer = new byte[64 * 1024];
                        for (int read; (read = in.read(buffer)) > 0;) {
                            out.write(buffer, 0, read);
                        }
                        session.fsync(out);
                    }
                    // Mutable: the installer adds the status to it.
                    Intent status = new Intent(this, SlopTubeActivity.class)
                            .setAction(ACTION_UPDATE_STATUS);
                    PendingIntent pending = PendingIntent.getActivity(this, 0, status,
                            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_MUTABLE);
                    session.commit(pending.getIntentSender());
                }
            } catch (IOException | RuntimeException failed) {
                nativeUpdateFailed(String.valueOf(failed.getMessage()));
            }
        }).start();
    }

    private void onUpdateStatus(Intent intent) {
        int status = intent.getIntExtra(PackageInstaller.EXTRA_STATUS,
                PackageInstaller.STATUS_FAILURE);
        if (status == PackageInstaller.STATUS_PENDING_USER_ACTION) {
            Intent confirm = confirmationOf(intent);
            if (confirm != null) {
                try {
                    startActivity(confirm);
                    return;
                } catch (RuntimeException failed) {
                    nativeUpdateFailed(String.valueOf(failed.getMessage()));
                    return;
                }
            }
        }
        if (status != PackageInstaller.STATUS_SUCCESS) {
            // Includes STATUS_FAILURE_ABORTED: the user declined.
            nativeUpdateFailed(String.valueOf(
                    intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE)));
        }
    }

    @SuppressWarnings("deprecation") // The typed getParcelableExtra exists from Android 13 only.
    private static Intent confirmationOf(Intent intent) {
        if (Build.VERSION.SDK_INT >= 33) {
            return intent.getParcelableExtra(Intent.EXTRA_INTENT, Intent.class);
        }
        return intent.getParcelableExtra(Intent.EXTRA_INTENT);
    }

    // --- Voice search ---------------------------------------------------------------------------

    // Android's speech recognizer (the Google app's, usually); the query comes back through
    // onActivityResult.
    public void startVoiceSearch() {
        runOnUiThread(() -> {
            Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
                    .putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL,
                            RecognizerIntent.LANGUAGE_MODEL_WEB_SEARCH)

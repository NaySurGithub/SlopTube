    @Override
    protected void onStop() {
        super.onStop();
        stopped = true;
        // The screen turning off also stops a picture-in-picture window; only finishing closes it.
        if (inPip && isFinishing()) {
            nativePictureInPictureDismissed();
        }
    }

    // --- Playback service -----------------------------------------------------------------------

    // The video playing, shown in the media notification, on the lock screen and to Bluetooth

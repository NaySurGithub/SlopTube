    // --- Picture-in-picture ---------------------------------------------------------------------

    // Whether leaving the app shrinks the playing video into a picture-in-picture window, and the
    // video's size for its shape.
    public void setPictureInPicture(final boolean allowed, final int width, final int height) {
        runOnUiThread(() -> {
            pipAllowed = allowed;
            if (width > 0 && height > 0) {
                float ratio = Math.max(1 / MAX_PIP_RATIO,
                        Math.min(MAX_PIP_RATIO, (float) width / height));
                pipAspect = new Rational(Math.round(ratio * 1000), 1000);
            }

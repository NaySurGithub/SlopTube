<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system splash screen shows the icon on the app's background, before the first frame. -->
    <style name="SlopTube" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
    </style>
</resources>

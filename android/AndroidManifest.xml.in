<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by CMake from android/AndroidManifest.xml.in; edit the template. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@SLOPTUBE_APP_ID@"
    android:versionCode="@SLOPTUBE_VERSION_CODE@"
    android:versionName="@PROJECT_VERSION@">

    <uses-sdk
        android:minSdkVersion="@SLOPTUBE_ANDROID_MIN_SDK@"
        android:targetSdkVersion="@SLOPTUBE_ANDROID_TARGET_SDK@" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptic feedback of the player (zoom, seeking), as in the official app. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Playback in the background, with its media notification (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- New upload notifications (UploadsJob), kept scheduled across reboots. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@SLOPTUBE_APP_NAME@"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@style/SlopTube">
        <activity
            android:name=".SlopTubeActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode"
            android:windowSoftInputMode="adjustNothing"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="@SLOPTUBE_LIB_NAME@" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".UploadsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
